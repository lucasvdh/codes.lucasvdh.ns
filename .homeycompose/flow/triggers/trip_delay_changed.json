{
  "id": "trip_delay_changed",
  "title": {
    "en": "Delay of next train changed by at least",
    "nl": "Vertraging volgende trein veranderd met minstens",
    "de": "Verspätung des nächsten Zuges geändert um mindestens"
  },
  "titleFormatted": {
    "en": "Delay of the next train changed by at least [[minutes]] minutes",
    "nl": "Vertraging van de volgende trein is met minstens [[minutes]] minuten veranderd",
    "de": "Verspätung des nächsten Zuges hat sich um mindestens [[minutes]] Minuten geändert"
  },
  "args": [
    { "name": "device", "type": "device", "filter": "driver_id=trip" },
    { "name": "minutes", "type": "number", "min": 1, "max": 120, "step": 1,
      "title": { "en": "Minutes", "nl": "Minuten", "de": "Minuten" },
      "placeholder": { "en": "10", "nl": "10", "de": "10" } }
  ],
  "tokens": [
    { "name": "departure_time", "type": "string",
      "title": { "en": "Departure", "nl": "Vertrek", "de": "Abfahrt" }, "example": "08:42" },
    { "name": "planned_departure_time", "type": "string",
      "title": { "en": "Planned departure", "nl": "Gepland vertrek", "de": "Geplante Abfahrt" }, "example": "08:40" },
    { "name": "expected_departure_time", "type": "string",
      "title": { "en": "Expected departure", "nl": "Verwacht vertrek", "de": "Erwartete Abfahrt" }, "example": "08:42" },
    { "name": "destination", "type": "string",
      "title": { "en": "Destination", "nl": "Bestemming", "de": "Ziel" }, "example": "Kropswolde" },
    { "name": "delay_minutes", "type": "number",
      "title": { "en": "Delay (min)", "nl": "Vertraging (min)", "de": "Verspätung (Min)" }, "example": 7 }
  ]
}
