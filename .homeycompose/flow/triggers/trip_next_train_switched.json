{
  "id": "trip_next_train_switched",
  "title": {
    "en": "Another train is now the next train",
    "nl": "Andere trein is nu de volgende trein",
    "de": "Anderer Zug ist jetzt der nächste Zug"
  },
  "titleFormatted": {
    "en": "Another train is now the next train on this route",
    "nl": "Een andere trein is nu de volgende trein op dit traject",
    "de": "Ein anderer Zug ist jetzt der nächste Zug auf dieser Strecke"
  },
  "args": [
    { "name": "device", "type": "device", "filter": "driver_id=trip" }
  ],
  "tokens": [
    { "name": "departure_time", "type": "string",
      "title": { "en": "Departure", "nl": "Vertrek", "de": "Abfahrt" }, "example": "08:42" },
    { "name": "planned_departure_time", "type": "string",
      "title": { "en": "Planned departure", "nl": "Gepland vertrek", "de": "Geplante Abfahrt" }, "example": "08:40" },
    { "name": "expected_departure_time", "type": "string",
      "title": { "en": "Expected departure", "nl": "Verwacht vertrek", "de": "Erwartete Abfahrt" }, "example": "08:42" },
    { "name": "destination", "type": "string",
      "title": { "en": "Destination", "nl": "Bestemming", "de": "Ziel" }, "example": "Kropswolde" },
    { "name": "track", "type": "string",
      "title": { "en": "Track", "nl": "Spoor", "de": "Gleis" }, "example": "5a" },
    { "name": "delay_minutes", "type": "number",
      "title": { "en": "Delay (min)", "nl": "Vertraging (min)", "de": "Verspätung (Min)" }, "example": 0 },
    { "name": "cancelled", "type": "boolean",
      "title": { "en": "Cancelled", "nl": "Uitgevallen", "de": "Ausgefallen" }, "example": false }
  ]
}
